# Windowshit ipconfig - 简体中文（zh-CN）

# 头部
header = Windows IP 配置

# 适配器标题
adapter-ethernet = 以太网适配器 { $name }:
adapter-loopback = 环回适配器 { $name }:
adapter-tunnel = 隧道适配器 { $name }:
adapter-wireless = 无线局域网适配器 { $name }:
adapter-unknown = 未知适配器 { $name }:

# 字段标签
field-media-state = Media State
value-media-disconnected = Media disconnected
field-dns-suffix = Connection-specific DNS Suffix
field-description = Description
field-physical-address = Physical Address
field-ipv4 = IPv4 Address
field-ipv6 = IPv6 Address
field-linklocal-v6 = Link-local IPv6 Address
field-autoconfig-v4 = Autoconfiguration IPv4 Address
field-subnet-mask = Subnet Mask
field-default-gateway = Default Gateway
field-dns-servers = DNS Servers
preferred = (preferred)

# 错误
error-no-adapters = 找不到网络适配器。
error-bad-parameter = 错误: 参数不正确。
