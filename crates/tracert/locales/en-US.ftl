# Windowshit tracert - English (en-US)

# Header（英文原版为两行）
trace-header-ip = Tracing route to { $target } [{ $ip }]
trace-header-hops = over a maximum of { $hops } hops:
trace-header-single = Tracing route to { $target } over a maximum of { $hops } hops

# Misc
trace-complete = Trace complete.
timeout-addr = Request timed out.
unable-resolve = Unable to resolve target system name { $host }.
error-bad-option = Bad option -{ $flag }.
error-unsupported = ERROR: Option -{ $flag } is not supported by this implementation.
error-no-target = ERROR: No target specified.
error-not-valid-address = { $addr } is not a valid address.
